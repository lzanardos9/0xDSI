# Local development settings for the 0xDSI Databricks App backend.
# Copy to .env and fill in. Never commit .env. Placeholders only - no real values here.
# In a deployed Databricks App these come from resources/app.yml, not from this file.

# Workspace auth for local runs: prefer `databricks auth login --host <workspace-url>`
# (OAuth U2M) and set DATABRICKS_CONFIG_PROFILE instead of putting a token here.
DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
DATABRICKS_CONFIG_PROFILE=DEFAULT

# Required
DATABRICKS_WAREHOUSE_ID=<sql-warehouse-id>
UNITY_CATALOG=soc_platform
UNITY_SCHEMA=security

# user = queries run as the signed-in user (needs user_api_scopes: sql); app = service principal
SOC_DATA_ACCESS_MODE=app

# Role mapping (comma-separated emails)
SOC_ADMIN_EMAILS=
SOC_ANALYST_EMAILS=

# Model serving (optional; AI features degrade without them)
LLM_ENDPOINT=databricks-meta-llama-3-3-70b-instruct
LLM_FALLBACK_ENDPOINT=
EMBEDDING_ENDPOINT=

# Lakewatch tables - exact names from your workspace; leave empty until known
LAKEWATCH_CATALOG=
LAKEWATCH_SCHEMA=
LAKEWATCH_TABLES=

# Chain-of-custody signing key: either a Databricks secret (preferred) ...
SOC_SECRET_SCOPE=soc-secrets
IDENTITY_CUSTODY_SECRET_KEY=identity_custody_key
# ... or, for local runs only, a raw key of at least 32 characters
IDENTITY_CUSTODY_KEY=

# Outbound automation webhooks (server-side only)
WORKFLOW_ALLOWED_HOSTS=
WORKFLOW_WEBHOOK_SECRET_KEY=

# Cross-origin access is off by default; set only if the UI is served from another domain
APP_DOMAIN=
